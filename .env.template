# ============================================================
#   APEX CREATIONS — ENVIRONMENT CONFIGURATION TEMPLATE
#   Copy this file to .env and fill in your real values.
#   NEVER commit .env to version control.
# ============================================================

# --- DATABASE (Render PostgreSQL) ----------------------------
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
# Example: postgresql://apex_user:secretpass@dpg-xxxxx.oregon-postgres.render.com/apex_db

# --- SERVER --------------------------------------------------
PORT=10000
NODE_ENV=production

# --- ADMIN CREDENTIALS (CHANGE THESE!) ----------------------
ADMIN_USERNAME=LordNejju
ADMIN_PASSWORD=YourStrongPasswordHere123!

# --- JWT SECRET (generate a long random string) -------------
JWT_SECRET=replace_this_with_a_very_long_random_secret_string_at_least_64_chars

# --- EMAIL (Nodemailer via Gmail) ---------------------------
# For Gmail: enable 2FA, then create an App Password at:
# https://myaccount.google.com/apppasswords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=callmetigger2018@gmail.com
EMAIL_PASS=your_gmail_app_password_here
EMAIL_TO=callmetigger2018@gmail.com

# --- RENDER DISK STORAGE PATH --------------------------------
UPLOAD_DIR=/var/data/uploads
# On Render, mount your disk at /var/data and set this path.
# Locally for testing you can use: ./uploads

# --- CORS ORIGIN (your Render frontend URL) -----------------
FRONTEND_ORIGIN=https://apex-creations.onrender.com
